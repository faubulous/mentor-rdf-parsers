# Expected RDF representation of select_star.rq
@prefix sparql: <https://w3id.org/sparql-syntax#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b1 a sparql:SelectQuery ;
     sparql:star "true"^^xsd:boolean .
_:b2 a sparql:Variable ;
     sparql:varName "s" .
_:b3 a sparql:Variable ;
     sparql:varName "p" .
_:b4 a sparql:Variable ;
     sparql:varName "o" .
_:b5 a sparql:TriplePattern ;
     sparql:subject _:b2 ;
     sparql:predicate _:b3 ;
     sparql:object _:b4 .
_:b6 rdf:first _:b5 ;
     rdf:rest rdf:nil .
_:b1 sparql:where _:b6 .
