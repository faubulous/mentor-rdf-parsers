# Expected RDF representation of select_star.rq
@prefix sps: <https://w3id.org/sparql-syntax#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b1 a sps:SelectQuery ;
     sps:star "true"^^xsd:boolean .
_:b2 a sps:Variable ;
     sps:varName "s" .
_:b3 a sps:Variable ;
     sps:varName "p" .
_:b4 a sps:Variable ;
     sps:varName "o" .
_:b5 a sps:TriplePattern ;
     sps:subject _:b2 ;
     sps:predicate _:b3 ;
     sps:object _:b4 .
_:b6 rdf:first _:b5 ;
     rdf:rest rdf:nil .
_:b1 sps:where _:b6 .
