# Expected RDF representation of subselect.rq
@prefix sparql: <https://w3id.org/sparql-syntax#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b232 a sparql:SelectQuery .
_:b233 a sparql:Variable ;
       sparql:varName "name" .
_:b234 rdf:first _:b233 ;
       rdf:rest rdf:nil .
_:b232 sparql:projection _:b234 .
_:b235 a sparql:SubSelect .
_:b236 rdf:first _:b233 ;
       rdf:rest rdf:nil .
_:b235 sparql:projection _:b236 .
_:b237 a sparql:Variable ;
       sparql:varName "s" .
_:b238 a sparql:TriplePattern ;
       sparql:subject _:b237 ;
       sparql:predicate <http://example.org/name> ;
       sparql:object _:b233 .
_:b239 rdf:first _:b238 ;
       rdf:rest rdf:nil .
_:b235 sparql:where _:b239 ;
       sparql:limit "10"^^xsd:integer .
_:b240 rdf:first _:b235 ;
       rdf:rest rdf:nil .
_:b232 sparql:where _:b240 .
