# Expected RDF representation of subselect.rq
@prefix sps: <https://w3id.org/sparql-syntax#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b232 a sps:SelectQuery .
_:b233 a sps:Variable ;
       sps:varName "name" .
_:b234 rdf:first _:b233 ;
       rdf:rest rdf:nil .
_:b232 sps:projection _:b234 .
_:b235 a sps:SubSelect .
_:b236 rdf:first _:b233 ;
       rdf:rest rdf:nil .
_:b235 sps:projection _:b236 .
_:b237 a sps:Variable ;
       sps:varName "s" .
_:b238 a sps:TriplePattern ;
       sps:subject _:b237 ;
       sps:predicate <http://example.org/name> ;
       sps:object _:b233 .
_:b239 rdf:first _:b238 ;
       rdf:rest rdf:nil .
_:b235 sps:where _:b239 ;
       sps:limit "10"^^xsd:integer .
_:b240 rdf:first _:b235 ;
       rdf:rest rdf:nil .
_:b232 sps:where _:b240 .
