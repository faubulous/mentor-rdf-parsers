# Expected RDF representation of collection.rq
@prefix sps: <https://w3id.org/sparql-syntax#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b250 a sps:SelectQuery .
_:b251 a sps:Variable ;
       sps:varName "s" .
_:b252 rdf:first _:b251 ;
       rdf:rest rdf:nil .
_:b250 sps:projection _:b252 .
_:b1 a sps:BlankNode .
_:b1_rest_1 a sps:BlankNode .
_:b1_rest_2 a sps:BlankNode .
_:b253 a sps:TriplePattern ;
       sps:subject _:b1 ;
       sps:predicate rdf:first ;
       sps:object "1"^^xsd:integer .
_:b254 a sps:TriplePattern ;
       sps:subject _:b1 ;
       sps:predicate rdf:rest ;
       sps:object _:b1_rest_1 .
_:b255 a sps:TriplePattern ;
       sps:subject _:b1_rest_1 ;
       sps:predicate rdf:first ;
       sps:object "2"^^xsd:integer .
_:b256 a sps:TriplePattern ;
       sps:subject _:b1_rest_1 ;
       sps:predicate rdf:rest ;
       sps:object _:b1_rest_2 .
_:b257 a sps:TriplePattern ;
       sps:subject _:b1_rest_2 ;
       sps:predicate rdf:first ;
       sps:object "3"^^xsd:integer .
_:b258 a sps:TriplePattern ;
       sps:subject _:b1_rest_2 ;
       sps:predicate rdf:rest ;
       sps:object rdf:nil .
_:b259 a sps:TriplePattern ;
       sps:subject _:b251 ;
       sps:predicate <http://example.org/list> ;
       sps:object _:b1 .
_:b260 rdf:first _:b253 ;
       rdf:rest _:b261 .
_:b261 rdf:first _:b254 ;
       rdf:rest _:b262 .
_:b262 rdf:first _:b255 ;
       rdf:rest _:b263 .
_:b263 rdf:first _:b256 ;
       rdf:rest _:b264 .
_:b264 rdf:first _:b257 ;
       rdf:rest _:b265 .
_:b265 rdf:first _:b258 ;
       rdf:rest _:b266 .
_:b266 rdf:first _:b259 ;
       rdf:rest rdf:nil .
_:b250 sps:where _:b260 .
