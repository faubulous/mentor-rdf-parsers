# Expected RDF representation of collection.rq
@prefix sparql: <https://w3id.org/sparql-syntax#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b250 a sparql:SelectQuery .
_:b251 a sparql:Variable ;
       sparql:varName "s" .
_:b252 rdf:first _:b251 ;
       rdf:rest rdf:nil .
_:b250 sparql:projection _:b252 .
_:b1 a sparql:BlankNode .
_:b1_rest_1 a sparql:BlankNode .
_:b1_rest_2 a sparql:BlankNode .
_:b253 a sparql:TriplePattern ;
       sparql:subject _:b1 ;
       sparql:predicate rdf:first ;
       sparql:object "1"^^xsd:integer .
_:b254 a sparql:TriplePattern ;
       sparql:subject _:b1 ;
       sparql:predicate rdf:rest ;
       sparql:object _:b1_rest_1 .
_:b255 a sparql:TriplePattern ;
       sparql:subject _:b1_rest_1 ;
       sparql:predicate rdf:first ;
       sparql:object "2"^^xsd:integer .
_:b256 a sparql:TriplePattern ;
       sparql:subject _:b1_rest_1 ;
       sparql:predicate rdf:rest ;
       sparql:object _:b1_rest_2 .
_:b257 a sparql:TriplePattern ;
       sparql:subject _:b1_rest_2 ;
       sparql:predicate rdf:first ;
       sparql:object "3"^^xsd:integer .
_:b258 a sparql:TriplePattern ;
       sparql:subject _:b1_rest_2 ;
       sparql:predicate rdf:rest ;
       sparql:object rdf:nil .
_:b259 a sparql:TriplePattern ;
       sparql:subject _:b251 ;
       sparql:predicate <http://example.org/list> ;
       sparql:object _:b1 .
_:b260 rdf:first _:b253 ;
       rdf:rest _:b261 .
_:b261 rdf:first _:b254 ;
       rdf:rest _:b262 .
_:b262 rdf:first _:b255 ;
       rdf:rest _:b263 .
_:b263 rdf:first _:b256 ;
       rdf:rest _:b264 .
_:b264 rdf:first _:b257 ;
       rdf:rest _:b265 .
_:b265 rdf:first _:b258 ;
       rdf:rest _:b266 .
_:b266 rdf:first _:b259 ;
       rdf:rest rdf:nil .
_:b250 sparql:where _:b260 .
