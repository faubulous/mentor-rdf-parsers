_:b293 a sparql:BuiltInCall ;
       sparql:function sparql:BOUND .
_:b294 rdf:first _:b290 ;
       rdf:rest rdf:nil .
_:b293 sparql:args _:b294 .
_:b295 a sparql:UnaryNot ;
