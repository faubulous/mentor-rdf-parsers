@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:b286 a sparql:SelectQuery .
_:b287 a sparql:Variable ;
       sparql:varName "s" .
_:b288 rdf:first _:b287 ;
       rdf:rest rdf:nil .
_:b286 sparql:projection _:b288 .
_:b289 a sparql:Variable ;
       sparql:varName "p" .
_:b290 a sparql:Variable ;
       sparql:varName "o" .
_:b291 a sparql:TriplePattern ;
       sparql:subject _:b287 ;
       sparql:predicate _:b289 ;
       sparql:object _:b290 .
